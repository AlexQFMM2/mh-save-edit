{
  "name": "mh-save-edit",
  "version": "0.1.5",
  "private": true,
  "description": "Monster Hunter save editor for MH3G, MH4G and MHGU.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node tools/prepare_appearance_sprite.mjs && node tools/electron-vite-dev.mjs dev",
    "build": "node tools/prepare_appearance_sprite.mjs && electron-vite build",
    "package:win": "pnpm build && electron-builder --win --x64 --dir --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild:electron-native": "node tools/rebuild-electron-native.mjs",
    "data:build:items": "node tools/build_item_catalog.mjs",
    "data:build:decorations": "node tools/build_decoration_catalog.mjs",
    "data:build:skills": "node tools/build_skill_catalog.mjs",
    "data:audit:skills": "node tools/audit_skill_catalog.mjs",
    "data:build:loadouts": "node tools/build_loadout_catalog.mjs",
    "data:audit:loadouts": "node tools/audit_loadout_catalog.mjs",
    "data:build:loadout": "node tools/build_loadout_catalog.mjs",
    "data:audit:loadout": "node tools/audit_loadout_catalog.mjs",
    "data:build:weapons": "node tools/build_weapon_catalog.mjs",
    "data:build:weapon-motions": "node tools/build_weapon_motion_catalog.mjs",
    "data:audit:weapon-motions": "node tools/audit_weapon_motion_catalog.mjs",
    "data:build:armors": "node tools/build_armor_catalog.mjs",
    "data:audit:monsters": "node tools/audit_monster_catalog.mjs",
    "data:build:monsters": "node tools/build_monster_catalog.mjs",
    "data:build:quests": "node tools/build_quest_catalog.mjs",
    "data:audit:quests": "node tools/audit_quest_catalog.mjs",
    "data:extract:palicoes": "node tools/extract_palico_resident.mjs",
    "data:build:palicoes": "node tools/build_palico_catalog.mjs",
    "data:audit:palicoes": "node tools/audit_palico_catalog.mjs",
    "data:inspect:skill-effect": "node tools/inspect_skill_effect.mjs",
    "data:repair:runtime": "node tools/repair_runtime_catalog.mjs",
    "data:audit:runtime": "node tools/audit_runtime_catalog.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.36.4",
    "egoroof-blowfish": "^4.0.3",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^0.468.0",
    "motion": "^13.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.alexqfmm.mhsaveedit",
    "productName": "MH Save Editor",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": [
          "*.sqlite"
        ]
      },
      {
        "from": "build/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "icon": "build/app-icon.ico"
    }
  }
}
